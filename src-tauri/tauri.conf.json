{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HTML Editor",
  "version": "1.0.5",
  "identifier": "com.nitin.htmleditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "HTML Editor",
        "width": 1280,
        "height": 860,
        "minWidth": 700,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "WYSIWYG editor for standalone HTML reports",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML Document",
        "description": "HTML document",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBREI1OEFFMzQ5N0MwOUQKUldTZHdKYzBybGpiT2xYcHB1NVFkQWVDck1BM3BaakdCOTlZWFV2ek1oSlI1RERBdnNYTXB1YmQK",
      "endpoints": [
        "https://github.com/jainnitin/html-editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
